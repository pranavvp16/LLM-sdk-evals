{
  "uid": "throughput",
  "title": "Inference throughput",
  "tags": ["ollive"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per minute",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "ClickHouse" },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT toStartOfMinute(started_at) AS t, provider, count() AS rpm FROM inference_logs WHERE $__timeFilter(started_at) GROUP BY t, provider ORDER BY t"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tokens per second",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "ClickHouse" },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT toStartOfMinute(started_at) AS t, provider, sum(output_tokens) / 60 AS tps FROM inference_logs WHERE $__timeFilter(started_at) GROUP BY t, provider ORDER BY t"
        }
      ]
    }
  ]
}
