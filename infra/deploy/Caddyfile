# Public ingress for the ollive deployment (CPU-only — no vLLM).
# TLS auto from Let's Encrypt against {$PUBLIC_HOSTNAME}.
# All upstreams are docker service names on the default compose network.

{$PUBLIC_HOSTNAME} {
    encode zstd gzip
    request_body {
        max_size 1MB
    }

    # ── Grafana (uses its own login form) ────────────────────────────────
    handle /grafana/* {
        reverse_proxy grafana:3000
    }

    # ── FastAPI under /api ────────────────────────────────────────────────
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:8000
    }

    # ── Unauthed health probe (used by monitors) ──────────────────────────
    handle /health {
        reverse_proxy api:8000
    }

    # ── OSS endpoint (Ollama, OpenAI-compat) ─────────────────────────────
    # Bearer-gated so the public /v1/* path is not an open inference proxy.
    # Local Ollama ignores the key; Caddy is the only auth layer here.
    @oss path /v1/*
    handle @oss {
        @authed header Authorization "Bearer {$OLLAMA_API_KEY}"
        handle @authed {
            reverse_proxy ollama:11434
        }
        respond 401
    }

    # ── Everything else → Next.js chatbot ────────────────────────────────
    handle {
        reverse_proxy chatbot:3000
    }
}

# Catch-all on raw IP / wrong hostname: refuse rather than serve a default cert.
:80, :443 {
    respond 421
}
