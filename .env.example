# PostgreSQL
POSTGRES_DB=ollive
POSTGRES_USER=ollive
POSTGRES_PASSWORD=ollive
# Host tests: localhost. Docker Compose: postgres service hostname.
POSTGRES_URL=postgresql+asyncpg://ollive:ollive@postgres:5432/ollive

# ClickHouse
# Host tests: localhost. Docker Compose: clickhouse service hostname.
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=ollive
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Redis
# Host tests: localhost. Docker Compose: redis service hostname.
REDIS_URL=redis://redis:6379/0

# API
API_PORT=8000
# Host tests: localhost. Docker Compose: api service hostname.
INGESTION_URL=http://api:8000/ingest/log

# LLM provider keys (set at least one for chat / eval)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_API_KEY=

# Chatbot
CHATBOT_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GF_SECURITY_ADMIN_PASSWORD=admin
