# PostgreSQL
POSTGRES_DB=ollive
POSTGRES_USER=ollive
POSTGRES_PASSWORD=ollive
# Host tests: localhost. Docker Compose: postgres service hostname.
POSTGRES_URL=postgresql+asyncpg://ollive:ollive@postgres:5432/ollive

# ClickHouse
# Host tests: localhost. Docker Compose: clickhouse service hostname.
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=ollive
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Redis
# Host tests: localhost. Docker Compose: redis service hostname.
REDIS_URL=redis://redis:6379/0

# API
API_PORT=8000
# Host tests: localhost. Docker Compose: api service hostname.
INGESTION_URL=http://api:8000/ingest/log

# LLM provider keys (set at least one for chat / eval)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# OSS backends (pick provider/model in the chatbot UI or /compare)
# Local dev: leave VLLM_BASE_URL empty unless you run vLLM yourself.
# Prod deployment (infra/deploy/docker-compose.prod.yml): set to http://vllm:8000
# so the api container reaches the vLLM container over the docker network.
VLLM_BASE_URL=
# Bearer token enforced by Caddy on the public /v1/* path. The deploy.sh
# script generates one. Local dev uses EMPTY since vLLM is unauthed.
VLLM_API_KEY=EMPTY
VLLM_MODEL=qwen2.5-1.5b-instruct

# Same key for both; pi uses provider id "opencode" (Zen) vs "opencode-go" (Go plan)
OPENCODE_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=kimi-k2.5
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4-flash

# Ollama (self-hosted OSS endpoint, deployed alongside the API on the prod VM)
# Local dev: leave OLLAMA_BASE_URL empty unless you run `ollama serve` yourself.
# Prod deployment: set to http://ollama:11434/v1 so the api container reaches
# the ollama container over the docker network. The model tag here must match
# the Ollama pull tag exactly (colon form, e.g. qwen2.5:1.5b).
OLLAMA_BASE_URL=
# Bearer token Caddy enforces on the public /v1/* path. The deploy.sh script
# generates one; local Ollama ignores this so any non-empty value is fine.
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:1.5b

# CLI eval only (optional; UI sends provider/model per chat request)
OSS_PROVIDER=
OSS_MODEL=

# Public deployment (set by infra/deploy/cloud-init.yaml on the VM)
# Local dev leaves this empty; CORS + Next.js fall back to localhost defaults.
PUBLIC_HOSTNAME=

# Chatbot
CHATBOT_PORT=3000
# Local dev hits the api container directly. Prod overlay bakes
# https://${PUBLIC_HOSTNAME}/api into the build via Dockerfile ARG.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GF_SECURITY_ADMIN_PASSWORD=admin
